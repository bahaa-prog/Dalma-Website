# Copy to .env (dev) or .env.production (VPS) and fill in real values.
# .env* is gitignored — never commit real secrets.

# Path to the SQLite database file. On the VPS this should point outside the
# deploy directory (e.g. /var/www/dalma-data/app.db) so redeploys never touch it.
DATABASE_URL=./data/app.db

# Absolute filesystem path where uploaded article images are stored. On the VPS
# this should be served directly by Nginx at /uploads/ (see deploy/nginx.conf).
UPLOADS_DIR=./uploads

# Single admin login. Generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# IMPORTANT: Next's env loader (@next/env) expands "$name" like a shell, so a
# raw bcrypt hash (full of "$2b$10$...") gets silently mangled. Escape every
# "$" as "\$" when pasting the hash in here, e.g.:
#   ADMIN_PASSWORD_HASH=\$2b\$10\$abcd...
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Long random string used to sign admin session cookies (jose/JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
